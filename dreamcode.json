{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "local",
      "command": ["mcp-server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "filesystem": {
      "type": "local",
      "command": ["mcp-server-filesystem", "."],
      "enabled": true
    },
    "pieces-ltm": {
      "type": "local",
      "command": ["mcp-remote", "http://localhost:39302/model_context_protocol/2024-11-05/sse", "--allow-http", "--transport", "sse-only"],
      "enabled": true
    },
    "youtube-transcript": {
      "type": "remote",
      "url": "https://youtube-transcript-mcp.ergut.workers.dev/sse",
      "enabled": true
    }
  },
  "provider": {
    "omniroute": {
      "name": "OmniRoute",
      "npm": "@ai-sdk/openai-compatible",
      "env": ["OMNIROUTE_API_KEY"],
      "options": {
        "baseURL": "http://127.0.0.1:21331/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "auto/coding:free": {
          "id": "auto/coding:free",
          "name": "Auto Coding Free",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 128000
          }
        }
      }
    },
    "agentrouter": {
      "name": "AgentRouter",
      "npm": "@ai-sdk/openai-compatible",
      "env": ["AGENTROUTER_API_KEY"],
      "options": {
        "baseURL": "https://agentrouter.org/v1",
        "apiKey": "{env:AGENTROUTER_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "reasoning": true,
          "tool_call": false,
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        }
      }
    }
  },
  "model": "opencode-go/deepseek-v4-flash",
  "plugin": [
    ".opencode/plugins/sensor-gate-enforcer.ts"
  ],
  "experimental": {
    "mcp_timeout": 300000
  }
}
