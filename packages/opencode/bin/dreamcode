#!/usr/bin/env bash
# Platform-aware binary launcher for dreamcode.
# Resolves the correct dist binary for the current platform.
# Created by the build script for development convenience.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "$(uname -s)" in
  Linux*)   PLAT="linux" ;;
  Darwin*)  PLAT="darwin" ;;
  CYGWIN*|MINGW*|MSYS*)
    # On Windows/Git Bash, delegate to the .cmd shim
    exec "$SCRIPT_DIR/dreamcode.cmd" "$@"
    ;;
  *)        echo "Unsupported platform: $(uname -s)" >&2; exit 1 ;;
esac
BINARY="$SCRIPT_DIR/../dist/dreamcode-${PLAT}-x64/bin/dreamcode"
if [ -x "$BINARY" ]; then
  exec "$BINARY" "$@"
else
  echo "dreamcode binary not found at: $BINARY" >&2
  echo "Run 'bun run build' (from packages/opencode) or 'bun run packages/opencode/script/build.ts' first." >&2
  echo "Or use 'bun dev' to run from source." >&2
  exit 1
fi
