{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nara": {
      "name": "Nara Router",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://router.bynara.id/v1"
      },
      "models": {
        "deepseek-v4-flash": { "name": "Deepseek V4 Flash" },
        "deepseek-v4-pro": { "name": "Deepseek V4 Pro" },
        "claude-opus-4.8": { "name": "Claude Opus 4.8" },
        "claude-opus-4.8-plan": { "name": "Claude Opus 4.8 Plan" },
        "claude-opus-4.7": { "name": "Claude Opus 4.7" },
        "claude-sonnet-5": { "name": "Claude Sonnet 5" },
        "claude-sonnet-5-plan": { "name": "Claude Sonnet 5 Plan" },
        "claude-fable-5": { "name": "Claude Fable 5" },
        "gpt-5.4": { "name": "GPT 5.4" },
        "gpt-5.5": { "name": "GPT 5.5" },
        "gpt-5.6-luna": { "name": "GPT 5.6 Luna" },
        "mimo-v2.5": { "name": "Mimo v2.5" },
        "mimo-v2.5-hermes": { "name": "Mimo v2.5 Hermes" },
        "mimo-v2.5-pro": { "name": "Mimo v2.5 Pro" },
        "mimo-v2.5-pro-hermes": { "name": "Mimo v2.5 Pro Hermes" },
        "mimo-v2.5-pro-ultraspeed": { "name": "Mimo v2.5 Pro Ultraspeed" },
        "qwen3.7-max": { "name": "Qwen 3.7 Max" },
        "kimi-k2.6": { "name": "Kimi K2.6" },
        "kimi-k2.7-code": { "name": "Kimi K2.7 Code" },
        "kimi-k2.7-code-free": { "name": "Kimi K2.7 Code Free" },
        "mistral-large": { "name": "Mistral Large" },
        "mistral-medium-3-5": { "name": "Mistral Medium 3.5" },
        "glm-5.2": { "name": "GLM 5.2" },
        "glm-5.2-plan": { "name": "GLM 5.2 Plan" },
        "minimax-m3": { "name": "MiniMax M3" },
        "tencent-hy3": { "name": "Tencent HY3" }
      }
    }
  },
  "permission": {},
  "plugin": [
    "./plugins/sensor-gate-enforcer.ts"
  ],
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
    "evolution": {
      "path": "/home/ronya/dreamcode/evolution",
      "description": "Agent evolution history: run_log.jsonl (past runs), agent_score.json (gamification), pieces_writes.jsonl (LTM writes), research/* (research reports)"
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
